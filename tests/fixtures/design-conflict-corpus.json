	"detect": {
		"note": "The rule that MAKES a conflict, moved out of a Svelte $effect.",
		"why": "The kernel skips special rows itself; the $effect did not. It was only ever safe because its ONE caller pre-filtered the list (StatusTable`s `statusRows` drops every special row before the loop), so the rule depended on a filter written somewhere else. `collisions` is a reserved analysis document its producer full-replaces on every run, and mv_data/the aggregates are not transformer rooms either — a version conflict on any of them is meaningless, and a second caller (a headless `ds design conflict list`) would have recorded one. Rust is right: the refusal belongs to the rule, not to the caller.",
		"request": {
			"op": "detect",
			"schema": "ds.design-conflict/v1",
			"rows": [
				{
					"name": "tx_1",
					"client_dirty": true,
					"client_server_known": true,
					"client_base_server_version": 4,
					"metadata": {
						"version": 7
					}
				},
				{
					"name": "tx_clean",
					"client_base_server_version": 4,
					"metadata": {
						"version": 7
					}
				},
				{
					"name": "tx_unknown",
					"client_dirty": true,
					"client_server_known": false,
					"client_base_server_version": 4,
					"metadata": {
						"version": 7
					}
				},
				{
					"name": "tx_current",
					"client_dirty": true,
					"client_server_known": true,
					"client_base_server_version": 7,
					"metadata": {
						"version": 7
					}
				},
				{
					"name": "tx_base_ahead",
					"client_dirty": true,
					"client_server_known": true,
					"client_base_server_version": 3,
					"metadata": {
						"version": 2
					}
				},
				{
					"name": "tx_nobase",
					"client_dirty": true,
					"client_server_known": true,
					"metadata": {
						"version": 7
					}
				},
				{
					"name": "collisions",
					"client_dirty": true,
					"client_server_known": true,
					"client_base_server_version": 4,
					"metadata": {
						"version": 7
					}
				}
			]
		},
		"expected_ts": [
			{
				"name": "tx_1",
				"baseVersion": 4,
				"currentVersion": 7
			},
			{
				"name": "tx_base_ahead",
				"baseVersion": 3,
				"currentVersion": 2
			},
			{
				"name": "collisions",
				"baseVersion": 4,
				"currentVersion": 7
			}
		],
		"expected": {
			"schema": "ds.design-conflict/v1",
			"op": "detect",
			"conflicts": [
				{
					"name": "tx_1",
					"base_version": 4,
					"current_version": 7,
					"code": "TRANSFORMER_VERSION_MISMATCH",
					"evidence": "inferred"
				},
				{
					"name": "tx_base_ahead",
					"base_version": 3,
					"current_version": 2,
					"code": "TRANSFORMER_VERSION_MISMATCH",
					"evidence": "inferred"
				}
			]
		}
	}
}
