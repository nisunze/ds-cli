{
	"schema": "ds.design-conflict-parity/v1",
	"purpose": "Campaign slice 14a — overwrite admissibility owned by ds-command-kernel::design_conflict. Each case holds one `check` request, what the deleted TypeScript answered (`expected_ts`: forceReviewEligibility + reviewedConflictIsCurrent + forceSaveFieldsForReview, recorded by running that code once before deleting it) and what the kernel answers (`expected`). A case where the two differ carries a `why`; the kernel is right in every one.",
	"refusal_rename": {
		"force_capability_missing": "pipeline.force is required.",
		"overwrite_not_selected": "Overwrite was not selected for this transformer.",
		"no_conflict_recorded": "No typed version conflict is recorded.",
		"review_missing": "Compare this transformer before overwriting.",
		"local_copy_changed": "The local copy changed after comparison. Compare again.",
		"local_base_version_changed": "The local base version changed after comparison. Compare again.",
		"review_not_pinned": "The comparison was not pinned to a cloud version.",
		"conflict_base_version_mismatch": "The local base version no longer matches the reviewed conflict.",
		"cloud_head_moved": "The cloud head moved after comparison. Compare again.",
		"review_not_finished": null
	},
