        "geospatial": [
          "gpkg"
        ],
        "tabular": [
          "xlsx"
        ]
      },
      "placements": {
        "gpkg": [
          "desktop",
          "web"
        ],
        "pdf__detail": [
          "desktop"
        ],
        "xlsx": [
          "desktop",
          "web"
        ]
