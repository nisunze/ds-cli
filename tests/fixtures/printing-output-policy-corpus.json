{
  "schema": "ds.printing-output-policy-parity/v1",
  "purpose": "Every distinct shape a project has stored in its design export row, with what ds-web's deleted `DesignOutputMatrix.selection()` answered (`expected_ts`, recorded by running that code once before deleting it) and what ds-command-kernel answers (`expected`). Where the two differ the row carries a `why`: the kernel is right in every one of them. Read by ds-web `src/tests/printing-output-policy-parity.test.ts` over the vendored WASM and by ds-command-kernel `tests/printing_output_policy_corpus.rs` over the native build, from byte-identical copies.",
  "options": [
    {
      "value": "shp",
      "label": "SHP"
    },
    {
      "value": "kmz",
      "label": "KMZ"
    },
    {
      "value": "xlsx",
      "label": "XLSX"
    },
    {
      "value": "geojson",
      "label": "GeoJSON"
    },
    {
      "value": "gpkg",
      "label": "GPKG"
    },
    {
      "value": "pdf__detail",
      "label": "PDF · Detail"
    },
    {
      "value": "pdf__overview",
      "label": "PDF · Overview"
    }
  ],
  "selection_cases": [
    {
      "id": "comma-string",
      "stored": "shp,kmz,xlsx",
      "expected_ts": {
        "schema": "ds.design-output-selection/v1",
        "prints": [],
        "geospatial": [
          "shp",
          "kmz"
        ],
        "tabular": [
          "xlsx"
        ],
        "execution": {}
      },
      "expected": {
        "schema": "ds.design-output-selection/v1",
        "prints": [],
        "geospatial": [
          "shp",
          "kmz"
        ],
        "tabular": [
          "xlsx"
        ]
      },
      "placements": {
        "kmz": [
          "desktop",
          "web"
        ],
        "shp": [
          "desktop",
          "web"
        ],
        "xlsx": [
          "desktop",
          "web"
        ]
      },
      "tokens": [
        "shp",
        "kmz",
        "xlsx"
      ]
    },
