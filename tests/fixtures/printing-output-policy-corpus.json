        "xlsx"
      ]
    },
    {
      "id": "legacy-alias-string",
      "stored": "A3_PDF;excel",
      "expected_ts": {
        "schema": "ds.design-output-selection/v1",
        "prints": [],
        "geospatial": [
          "A3_PDF",
          "excel"
        ],
        "tabular": [],
        "execution": {}
      },
      "expected": {
        "schema": "ds.design-output-selection/v1",
        "prints": [],
        "geospatial": [
          "pdf_a3"
        ],
        "tabular": [
          "xlsx"
        ]
      },
      "placements": {
        "pdf_a3": [
          "desktop"
        ],
        "xlsx": [
          "desktop",
          "web"
        ]
      },
      "tokens": [
        "pdf_a3",
        "xlsx"
      ],
      "why": "The kernel trims, lowercases and aliases a legacy token through the one table `report_formats::alias_format` holds \u2014 the same map ds-brain applies (`networkReporterIndividualFormatAliases`) \u2014 so `A3_PDF` is `pdf_a3` (class `print`) and `excel` is `xlsx` (class `tabular`). The deleted TypeScript carried the operator's casing through and never aliased, so it named two outputs no catalogue offers and gave them the placement rule of a class neither belongs to."
    },
    {
      "id": "token-array",
      "stored": [
        "gpkg",
        "xlsx",
        "pdf__detail"
      ],
      "expected_ts": {
        "schema": "ds.design-output-selection/v1",
        "prints": [
          {
            "layout_id": "detail",
            "enabled": true,
            "formats": [
              "pdf"
            ]
          }
        ],
        "geospatial": [
          "gpkg"
        ],
        "tabular": [
          "xlsx"
        ],
        "execution": {}
      },
      "expected": {
        "schema": "ds.design-output-selection/v1",
        "prints": [
          {
            "layout_id": "detail",
            "enabled": true,
            "formats": [
              "pdf"
