{
  "schema": "ds.wasm-unit/v1",
  "component": "command-kernel",
  "package": "ds-command-kernel",
  "crate": ".",
  "stem": "ds_command_kernel",
  "features": ["wasm"],
  "metadataArgs": ["--features", "ds-command-kernel/wasm"],
  "identityExport": "uiEngineBuildIdentity",
  "inputsSchema": "ds.ui-wasm-build-inputs/v1",
  "stamps": {
    "DS_COMMAND_KERNEL_SOURCE_SHA": "owner",
    "DS_UI_BUILD_CONFIG_SHA256": "manifest",
    "DS_SOLAR_SOURCE_SHA": "revision:ds-solar",
    "DS_SOLAR_CARGO_LOCK_PATH": "lockfile"
  },
  "capture": ["ds-solar", "ds-network-reporter", "ds-interactions"],
  "sourcePins": {
    "file": "release/ui-wasm-source.json",
    "schema": "ds.ui-wasm-source/v1",
    "component": "command-kernel"
  },
  "targets": {
    "web-local": {
      "features": ["wasm", "platform-web", "lane-canary", "topology-local"],
      "env": ["DS_FIREBASE_PROJECT_ID", "DS_FIREBASE_API_KEY"]
    },
    "desktop-local": {
      "features": ["wasm", "platform-desktop", "lane-canary", "topology-local"],
      "env": ["DS_FIREBASE_PROJECT_ID", "DS_FIREBASE_API_KEY"]
    },
    "web-canary": {
      "features": ["wasm", "platform-web", "lane-canary"],
      "env": ["DS_GATEWAY_URL_CANARY", "DS_PLATFORM_API_KEY", "DS_FIREBASE_PROJECT_ID", "DS_FIREBASE_API_KEY"]
    },
    "web-production": {
      "features": ["wasm", "platform-web", "lane-production"],
      "env": ["DS_GATEWAY_URL_PRODUCTION", "DS_PLATFORM_API_KEY", "DS_FIREBASE_PROJECT_ID", "DS_FIREBASE_API_KEY"]
    },
    "desktop-dev-canary": {
      "features": ["wasm", "platform-desktop", "lane-canary"],
      "env": ["DS_GATEWAY_URL_CANARY", "DS_PLATFORM_API_KEY", "DS_FIREBASE_PROJECT_ID", "DS_FIREBASE_API_KEY"]
    },
    "desktop-canary": {
      "features": ["wasm", "platform-desktop", "lane-canary"],
      "env": ["DS_GATEWAY_URL_CANARY", "DS_PLATFORM_API_KEY", "DS_FIREBASE_PROJECT_ID", "DS_FIREBASE_API_KEY"]
    },
    "desktop-production": {
      "features": ["wasm", "platform-desktop", "lane-production"],
      "env": ["DS_GATEWAY_URL_PRODUCTION", "DS_PLATFORM_API_KEY", "DS_FIREBASE_PROJECT_ID", "DS_FIREBASE_API_KEY"]
    }
  },
  "releaseTargets": {
    "canary": "desktop-canary",
    "stable": "desktop-production"
  }
}
