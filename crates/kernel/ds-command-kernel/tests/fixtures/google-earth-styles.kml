<?xml version="1.0"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
  <Style id="red"><LineStyle><color>80402010</color><width>3.5</width></LineStyle><LabelStyle><color>ff00ff00</color><scale>1.2</scale></LabelStyle></Style>
  <Style id="hidden"><PolyStyle><color>400000ff</color><fill>0</fill><outline>0</outline></PolyStyle></Style>
  <StyleMap id="select"><Pair><key>highlight</key><styleUrl>#hidden</styleUrl></Pair><Pair><key>normal</key><styleUrl>#red</styleUrl></Pair></StyleMap>
  <Folder><name>Lines</name>
    <Placemark><name>Shared</name><styleUrl>#red</styleUrl><LineString><coordinates>30,-2 30.001,-2</coordinates></LineString></Placemark>
    <Placemark><name>Normal</name><styleUrl>#select</styleUrl><Style><LineStyle><width>7</width></LineStyle></Style><LineString><coordinates>30,-2.001 30.001,-2.001</coordinates></LineString></Placemark>
    <Placemark><name>Malformed</name><Style><LineStyle><color>not-a-color</color></LineStyle></Style><LineString><coordinates>30,-2.002 30.001,-2.002</coordinates></LineString></Placemark>
  </Folder>
  <Folder><name>Areas</name><Placemark><name>Unfilled</name><styleUrl>#hidden</styleUrl><Polygon><outerBoundaryIs><LinearRing><coordinates>30,-2 30.001,-2 30.001,-2.001 30,-2</coordinates></LinearRing></outerBoundaryIs></Polygon></Placemark></Folder>
</Document></kml>
