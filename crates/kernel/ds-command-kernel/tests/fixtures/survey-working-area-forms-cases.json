{
  "schema": "ds.survey-working-area-forms-cases/v1",
  "purpose": "Which survey forms the working area loads, replayed. Each case carries the request (the schema defaults to the module's) and the answer the kernel must give: the parsed answer, or {\"error\": \"<the exact Err string>\"} when the request itself is refused. ds-web replays the same file through the vendored WASM so the browser's working area cannot load a form the CLI would not.",
  "note": "Re-record expected with DS_SURVEY_WORKING_AREA_FORMS_CASES_WRITE=1 cargo test --test survey_working_area_forms_cases after a deliberate rule change, and say why in the commit.",
  "cases": [
    {
      "id": "read-never-chosen",
      "why": "Before the operator chooses on this host the working area loads nothing: the read says so with the remedy, and a count the host already knew rides along without a fetch.",
      "request": {
        "project": "p1",
        "document": {
          "project_id": "p1",
          "survey_layers": [
            {
              "key": "tr",
              "label": "Transformers",
              "geometry_type": "Point",
              "layer_ids": [
                "tr_pts",
                "tr_pts__label"
              ],
              "style_ref": "tr",
              "fields": [
                {
                  "name": "name",
                  "type": "string"
                }
              ]
            },
            {
              "key": "lv",
              "label": "LV poles",
              "geometry_type": "Point",
              "layer_ids": [
                "lv_pts"
              ],
              "style_ref": "lv"
            },
            {
              "key": "mv",
              "label": "MV poles",
              "geometry_type": "Point",
              "layer_ids": [
                "mv_pts"
              ],
              "style_ref": "mv"
            },
            {
              "key": "tr",
              "label": "Duplicate row",
              "layer_ids": [
                "tr_dup"
              ],
              "style_ref": "tr"
            }
          ],
          "layers": [],
          "sources": {},
          "matrix": {
            "survey": {}
          }
        },
        "counts": {
          "tr": 12
        },
        "op": {
          "kind": "read"
        }
      },
      "expected": {
        "schema": "ds.survey-working-area-forms/v1",
        "project": "p1",
        "op": "read",
        "chosen": false,
        "form_count": 3,
        "selected_count": 0,
        "loads": [],
        "stale": [],
        "forms": [
          {
            "slug": "tr",
            "label": "Transformers",
            "selected": false,
            "layer_ids": [
              "tr_pts",
              "tr_pts__label"
            ],
            "count": 12
          },
          {
            "slug": "lv",
            "label": "LV poles",
            "selected": false,
            "layer_ids": [
              "lv_pts"
            ],
            "count": null
          },
          {
            "slug": "mv",
            "label": "MV poles",
            "selected": false,
            "layer_ids": [
              "mv_pts"
            ],
            "count": null
          }
        ],
        "remedy": "no survey form is selected for the working area on this host, so it loads nothing; select forms with `ds survey working-area select --form <slug> …` or `--all`"
      }
    },
