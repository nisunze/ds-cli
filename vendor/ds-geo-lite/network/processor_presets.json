  "numeric_settings": [
    {
      "default": 0.1,
      "description": "Maximum endpoint gap, in metres, that draft LV work may heal onto another carrier. Retained existing/approved endpoints are never moved by this tolerance.",
      "key": "weld_tolerance",
      "label": "Draft endpoint heal tolerance",
      "max": 2,
      "min": 0,
      "step": 0.05,
      "unit": "m",
      "visible_when": [
        {
          "equals": true,
          "key": "build_network"
        }
      ]
    },
    {
      "default": 1,
      "description": "Deflection-angle threshold for generated pole cleanup. 0° removes true inline vertices only; positive values also remove bends below that angle. Applies only when Keep LV poles is off and Remove weak angles is on.",
      "key": "weak_angle_threshold_deg",
      "label": "Angle threshold",
      "max": 90,
      "step": 0.1,
      "unit": "deg",
      "visible_when": [
        {
          "equals": true,
          "key": "build_network"
        },
        {
          "equals": false,
          "key": "keep_lv_poles"
        },
        {
          "equals": true,
          "key": "remove_inline_vertex"
        }
      ]
    }
  ],
  "presets": [
    {
      "description": "Rebuild poles, spans, and service cables from scratch; size cables and transformer KVA. Reports and combined mirror are off by default so transformer design iteration stays cheap.",
      "label": "Drafting",
      "name": "drafting",
