        "enrich_admin_bounds_before_mirror": true,
        "export_reports_for_download": false,
        "extend_service_cables": false,
        "include_in_combined_reports": false,
        "join_lv_cables_of_same_size": true,
        "keep_flying_stay": false,
        "keep_lv_lines_length": false,
        "keep_lv_lines_sizes": true,
        "keep_lv_lines_topology": true,
        "keep_lv_poles": false,
        "keep_service_cables": false,
        "keep_service_cables_sizes": false,
        "override_uploaded_customers": false,
